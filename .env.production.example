# Template only. Inject all secrets from the deployment platform's secret manager.
NODE_ENV=production
WEB_PORT=3000
API_PORT=4000
API_BASE_URL=https://api.example.com/api/v1
NEXT_PUBLIC_API_URL=https://api.example.com/api/v1
WEB_ORIGIN=https://studio.example.com
DATABASE_URL=${DATABASE_URL_FROM_SECRET_MANAGER}
REDIS_URL=${REDIS_URL_FROM_SECRET_MANAGER}
S3_ENDPOINT=https://s3.example.com
S3_REGION=replace_with_deployment_region
S3_BUCKET=replace_with_private_bucket
S3_ACCESS_KEY=${S3_ACCESS_KEY_FROM_SECRET_MANAGER}
S3_SECRET_KEY=${S3_SECRET_KEY_FROM_SECRET_MANAGER}
S3_FORCE_PATH_STYLE=false
JWT_SECRET=${JWT_SECRET_FROM_SECRET_MANAGER}
LOG_LEVEL=info
