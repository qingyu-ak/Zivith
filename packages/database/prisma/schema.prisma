generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MemberRole {
  owner
  editor
  viewer
}

enum ApprovalState {
  draft
  review
  approved
}

enum ShotState {
  draft
  prompting
  generating
  review
  approved
}

enum AssetType {
  character
  location
  prop
  style
  media
  knowledge
  prompt_template
}

enum AssetState {
  draft
  active
  archived
}

enum MediaType {
  image
  video
  audio
  three_d_model
  document
}

enum MediaSource {
  uploaded
  generated
  imported
}

enum JobStatus {
  queued
  running
  completed
  failed
  cancelled
}

enum OutputStatus {
  queued
  generating
  completed
  failed
}

enum RequirementStatus {
  pending
  generating
  review
  approved
  rejected
}

/// Track H — EntityRevision.change_kind (ADR-0007 / entity-state-timeline-track)
enum EntityChangeKind {
  baseline
  create
  update
  transition
  delete
  restore
  merge
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  passwordHash  String         @map("password_hash")
  displayName   String         @map("display_name")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  deletedAt     DateTime?      @map("deleted_at")
  memberships   ProjectMember[]
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]
  projects      Project[]      @relation("ProjectOwner")

  @@map("users")
}

model RefreshToken {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  tokenHash  String    @unique @map("token_hash")
  familyId   String    @map("family_id")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  replacedBy String?   @map("replaced_by")
  createdAt  DateTime  @default(now()) @map("created_at")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, familyId])
  @@map("refresh_tokens")
}

model Project {
  id          String          @id @default(uuid())
  ownerId     String          @map("owner_id")
  name        String
  description String?
  // 世界观轻量结构化字段（genre/premise/rules/notes），由 Creator Chat 自动提炼并随提案落库
  worldview   Json            @default("{}")
  defaults    Json            @default("{}")
  settings    Json            @default("{}")
  /// Absolute folder path that identifies this world workspace (Electron open-folder).
  workspacePath String?       @map("workspace_path")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  deletedAt   DateTime?       @map("deleted_at")
  owner       User            @relation("ProjectOwner", fields: [ownerId], references: [id])
  members     ProjectMember[]
  stories     Story[]
  assets      Asset[]
  media       Media[]
  tasks       Task[]
  workflows   WorkflowRun[]
  usageRecords UsageRecord[]
  entityRevisions EntityRevision[]
  changeEvents    ChangeEvent[]
  projectSequence ProjectSequence?
  worldEvents     WorldEvent[]
  relationships   Relationship[]
  timeline        ProjectTimeline?
  creatorThreads  CreatorChatThread[]

  @@index([ownerId, deletedAt])
  @@index([ownerId, workspacePath])
  @@map("projects")
}

model ProjectMember {
  projectId String     @map("project_id")
  userId    String     @map("user_id")
  role      MemberRole @default(viewer)
  createdAt DateTime   @default(now()) @map("created_at")
  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@index([userId])
  @@map("project_members")
}

model Story {
  id                    String         @id @default(uuid())
  projectId             String         @map("project_id")
  title                 String
  logline               String?
  synopsis              String?
  genre                 String?
  theme                 String?
  targetAudience        String?        @map("target_audience")
  tone                  String?
  targetDurationSeconds Int?           @map("target_duration_seconds")
  language              String?
  screenplay            String?
  state                 ApprovalState  @default(draft)
  overrides             Json?
  order                 Int
  createdAt             DateTime       @default(now()) @map("created_at")
  updatedAt             DateTime       @updatedAt @map("updated_at")
  deletedAt             DateTime?      @map("deleted_at")
  project               Project        @relation(fields: [projectId], references: [id])
  scenes                Scene[]
  segments              StorySegment[]

  @@index([projectId, order, deletedAt])
  @@map("stories")
}

/// Ordered Scene grouping inside a Story (ADR-0006 / V0.4 W3). Optional — zero segments = legacy behavior.
model StorySegment {
  id          String        @id @default(uuid())
  storyId     String        @map("story_id")
  order       Int
  title       String
  synopsis    String?
  draft       String?
  state       ApprovalState @default(draft)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  deletedAt   DateTime?     @map("deleted_at")
  story       Story         @relation(fields: [storyId], references: [id], onDelete: Cascade)
  scenes      Scene[]

  @@index([storyId, order, deletedAt])
  @@map("story_segments")
}

model Scene {
  id               String                   @id @default(uuid())
  storyId          String                   @map("story_id")
  projectId        String                   @map("project_id")
  segmentId        String?                  @map("segment_id")
  title            String
  description      String?
  order            Int
  state            ApprovalState            @default(draft)
  locationId       String?                  @map("location_id")
  time             String?
  weather          String?
  mood             String?
  characterIds     String[]                 @default([]) @map("character_ids")
  overrides        Json?
  approvedSnapshot Json?                    @map("approved_snapshot")
  createdAt        DateTime                 @default(now()) @map("created_at")
  updatedAt        DateTime                 @updatedAt @map("updated_at")
  deletedAt        DateTime?                @map("deleted_at")
  story            Story                    @relation(fields: [storyId], references: [id])
  segment          StorySegment?            @relation(fields: [segmentId], references: [id], onDelete: SetNull)
  shots            Shot[]
  requirements     VisualAssetRequirement[]

  @@index([storyId, order, deletedAt])
  @@index([segmentId, deletedAt])
  @@index([projectId, deletedAt])
  @@map("scenes")
}

model Shot {
  id               String       @id @default(uuid())
  sceneId          String       @map("scene_id")
  projectId        String       @map("project_id")
  order            Int
  label            String?
  state            ShotState    @default(draft)
  narrativeMode    String       @default("present") @map("narrative_mode")
  locationArea     String?      @map("location_area")
  camera           Json?
  composition      Json?
  lighting         Json?
  color            Json?
  mood             String?
  style            Json?
  characters       Json         @default("[]")
  dialogue         Json?
  action           Json?
  audio            Json?
  prompt           Json         @default("{\"source\":\"auto\"}")
  approvedSnapshot Json?        @map("approved_snapshot")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")
  deletedAt        DateTime?    @map("deleted_at")
  scene            Scene        @relation(fields: [sceneId], references: [id])
  outputs          Output[]
  prompts          PromptVersion[]

  @@index([sceneId, order, deletedAt])
  @@index([projectId, deletedAt])
  @@map("shots")
}

model Asset {
  id                 String                   @id @default(uuid())
  projectId          String                   @map("project_id")
  type               AssetType
  state              AssetState               @default(draft)
  name               String
  description        String
  aliases            String[]                 @default([])
  baseCharacterId    String?                  @map("base_character_id")
  appearance         Json?
  data               Json                     @default("{}")
  referenceImages    String[]                 @default([]) @map("reference_images")
  tags               String[]                 @default([])
  createdAt          DateTime                 @default(now()) @map("created_at")
  updatedAt          DateTime                 @updatedAt @map("updated_at")
  deletedAt          DateTime?                @map("deleted_at")
  project            Project                  @relation(fields: [projectId], references: [id])
  appearanceVariants AssetAppearanceVariant[]

  @@index([projectId, type, state, deletedAt])
  @@index([baseCharacterId])
  @@map("assets")
}

/// Character × narrative appearance state (V0.4 W2). Character assets only in v1.
model AssetAppearanceVariant {
  id                String        @id @default(uuid())
  assetId           String        @map("asset_id")
  key               String
  title             String
  changeReason      String?       @map("change_reason")
  description       String?
  anchorMediaId     String?       @map("anchor_media_id")
  candidateMediaIds String[]      @default([]) @map("candidate_media_ids")
  state             ApprovalState @default(draft)
  order             Int           @default(0)
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")
  deletedAt         DateTime?     @map("deleted_at")
  asset             Asset         @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([assetId, key])
  @@index([assetId, order, deletedAt])
  @@map("asset_appearance_variants")
}

model Media {
  id                 String       @id @default(uuid())
  projectId          String       @map("project_id")
  name               String
  mediaType          MediaType    @map("media_type")
  mimeType           String       @map("mime_type")
  storageKey         String       @unique @map("storage_key")
  url                String
  thumbnailUrl       String?      @map("thumbnail_url")
  fileSizeBytes      BigInt?      @map("file_size_bytes")
  resolution         String?
  durationSeconds    Float?       @map("duration_seconds")
  source             MediaSource
  generationMetadata Json?        @map("generation_metadata")
  tags               String[]     @default([])
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")
  deletedAt          DateTime?    @map("deleted_at")
  project            Project      @relation(fields: [projectId], references: [id])

  @@index([projectId, mediaType, deletedAt])
  @@map("media")
}

model VisualAssetRequirement {
  id                String            @id @default(uuid())
  sceneId           String            @map("scene_id")
  assetType         AssetType         @map("asset_type")
  assetId           String            @map("asset_id")
  variantKey        String            @map("variant_key")
  required          Boolean
  reason            String
  status            RequirementStatus @default(pending)
  candidateMediaIds String[]          @default([]) @map("candidate_media_ids")
  approvedMediaId   String?           @map("approved_media_id")
  generationJobId   String?           @map("generation_job_id")
  version           Int               @default(1)
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")
  deletedAt         DateTime?         @map("deleted_at")
  scene             Scene             @relation(fields: [sceneId], references: [id])

  @@index([sceneId, assetType, assetId, variantKey])
  @@index([sceneId, status, deletedAt])
  @@map("visual_asset_requirements")
}

model PromptVersion {
  id         String   @id @default(uuid())
  shotId     String   @map("shot_id")
  positive   String
  negative   String?
  source     String
  approvedAt DateTime? @map("approved_at")
  createdAt  DateTime @default(now()) @map("created_at")
  shot       Shot     @relation(fields: [shotId], references: [id])

  @@index([shotId, createdAt])
  @@map("prompt_versions")
}

model Output {
  id              String       @id @default(uuid())
  shotId          String       @map("shot_id")
  status          OutputStatus @default(queued)
  videoUrl        String?      @map("video_url")
  thumbnailUrl    String?      @map("thumbnail_url")
  provider        String
  providerJobId   String?      @unique @map("provider_job_id")
  idempotencyKey  String       @unique @map("idempotency_key")
  model           String
  modelVersion    String?      @map("model_version")
  parameters      Json
  durationSeconds Float?       @map("duration_seconds")
  resolution      String?
  fileSizeBytes   BigInt?      @map("file_size_bytes")
  isActive        Boolean      @default(false) @map("is_active")
  promptSnapshot  Json         @map("prompt_snapshot")
  contextSnapshot Json         @map("context_snapshot")
  visualMediaIds  String[]     @default([]) @map("visual_media_ids")
  errorCode       String?      @map("error_code")
  generatedAt     DateTime?    @map("generated_at")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  shot            Shot         @relation(fields: [shotId], references: [id])

  @@index([shotId, status])
  @@map("outputs")
}

model Task {
  id             String    @id @default(uuid())
  projectId      String    @map("project_id")
  type           String
  status         JobStatus @default(queued)
  idempotencyKey String    @unique @map("idempotency_key")
  provider       String?
  providerJobId  String?   @map("provider_job_id")
  payload        Json
  result         Json?
  errorCode      String?   @map("error_code")
  attempts       Int       @default(0)
  createdAt      DateTime  @default(now()) @map("created_at")
  startedAt      DateTime? @map("started_at")
  completedAt    DateTime? @map("completed_at")
  project        Project   @relation(fields: [projectId], references: [id])

  @@index([projectId, status])
  @@index([provider, providerJobId])
  @@map("tasks")
}

model WorkflowRun {
  id         String         @id @default(uuid())
  projectId  String         @map("project_id")
  type       String
  status     JobStatus      @default(queued)
  input      Json
  state      Json           @default("{}")
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")
  project    Project        @relation(fields: [projectId], references: [id])
  steps      WorkflowStep[]

  @@index([projectId, status])
  @@map("workflow_runs")
}

model WorkflowStep {
  id            String                @id @default(uuid())
  workflowRunId String                @map("workflow_run_id")
  name          String
  status        JobStatus             @default(queued)
  input         Json
  output        Json?
  order         Int
  startedAt     DateTime?             @map("started_at")
  completedAt   DateTime?             @map("completed_at")
  workflowRun   WorkflowRun           @relation(fields: [workflowRunId], references: [id], onDelete: Cascade)
  attempts      WorkflowStepAttempt[]

  @@unique([workflowRunId, order])
  @@map("workflow_steps")
}

model WorkflowStepAttempt {
  id             String       @id @default(uuid())
  workflowStepId String       @map("workflow_step_id")
  attempt        Int
  status         JobStatus    @default(queued)
  provider       String?
  model          String?
  inputHash      String       @map("input_hash")
  usage          Json?
  errorCode      String?      @map("error_code")
  errorMessage   String?      @map("error_message")
  startedAt      DateTime     @default(now()) @map("started_at")
  finishedAt     DateTime?    @map("finished_at")
  workflowStep   WorkflowStep @relation(fields: [workflowStepId], references: [id], onDelete: Cascade)

  @@unique([workflowStepId, attempt])
  @@index([workflowStepId, status])
  @@map("workflow_step_attempts")
}

model AuditLog {
  id           String   @id @default(uuid())
  actorId      String?  @map("actor_id")
  projectId    String?  @map("project_id")
  entityType   String   @map("entity_type")
  entityId     String   @map("entity_id")
  action       String
  before       Json?
  after        Json?
  metadata     Json?
  createdAt    DateTime @default(now()) @map("created_at")
  actor        User?    @relation(fields: [actorId], references: [id])

  @@index([projectId, entityType, entityId])
  @@map("audit_logs")
}

model ProviderCredential {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  provider        String
  encryptedSecret Bytes    @map("encrypted_secret")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@unique([userId, provider])
  @@map("provider_credentials")
}

model ProviderUsage {
  id            String   @id @default(uuid())
  projectId     String   @map("project_id")
  userId        String   @map("user_id")
  provider      String
  model         String
  operation     String
  units         Decimal  @db.Decimal(18, 6)
  estimatedCost Decimal  @map("estimated_cost") @db.Decimal(18, 6)
  metadata      Json?
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([projectId, provider, createdAt])
  @@map("provider_usage")
}

// Per-call usage ledger (V0.4 W7 first pass). Separate from ProviderUsage (BYOK/limits later).
model UsageRecord {
  id            String   @id @default(uuid())
  projectId     String   @map("project_id")
  taskType      String   @map("task_type")
  provider      String
  model         String
  quantity      Decimal  @db.Decimal(18, 6)
  unit          String
  estimatedCost Decimal? @map("estimated_cost") @db.Decimal(18, 6)
  metadata      Json?
  createdAt     DateTime @default(now()) @map("created_at")
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@index([projectId, taskType])
  @@map("usage_records")
}

/// Track H H2 — immutable Entity State history (append-only). Not a Presentation Timeline Item.
model EntityRevision {
  id                 String           @id @default(uuid())
  projectId          String           @map("project_id")
  entityType         String           @map("entity_type")
  entityId           String           @map("entity_id")
  revision           Int
  parentRevisionId   String?          @map("parent_revision_id")
  /// null = main line; CreativeBranch ids deferred (H10)
  branchId           String?          @map("branch_id")
  schemaVersion      Int              @default(1) @map("schema_version")
  snapshot           Json?
  snapshotRef        String?          @map("snapshot_ref")
  snapshotHash       String           @map("snapshot_hash")
  changeKind         EntityChangeKind @map("change_kind")
  changedFields      String[]         @default([]) @map("changed_fields")
  actorId            String?          @map("actor_id")
  createdAt          DateTime         @default(now()) @map("created_at")
  project            Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parentRevision     EntityRevision?  @relation("EntityRevisionParent", fields: [parentRevisionId], references: [id], onDelete: SetNull)
  childRevisions     EntityRevision[] @relation("EntityRevisionParent")
  changeEvents       ChangeEvent[]

  @@unique([entityType, entityId, revision])
  @@index([projectId, entityType, entityId])
  @@index([projectId, createdAt])
  @@map("entity_revisions")
}

/// Track H H2 — system-committed facts (audit / SSE / causation). Not Presentation Timeline.
model ChangeEvent {
  id               String          @id @default(uuid())
  projectId        String          @map("project_id")
  sequence         BigInt
  eventType        String          @map("event_type")
  schemaVersion    Int             @default(1) @map("schema_version")
  entityType       String?         @map("entity_type")
  entityId         String?         @map("entity_id")
  entityRevisionId String?         @map("entity_revision_id")
  actorType        String?         @map("actor_type")
  actorId          String?         @map("actor_id")
  sourceType       String?         @map("source_type")
  sourceId         String?         @map("source_id")
  correlationId    String?         @map("correlation_id")
  causationId      String?         @map("causation_id")
  idempotencyKey   String?         @map("idempotency_key")
  payload          Json            @default("{}")
  occurredAt       DateTime        @map("occurred_at")
  createdAt        DateTime        @default(now()) @map("created_at")
  project          Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  entityRevision   EntityRevision? @relation(fields: [entityRevisionId], references: [id], onDelete: SetNull)

  @@unique([projectId, sequence])
  @@index([projectId, createdAt])
  @@index([projectId, entityType, entityId])
  @@index([projectId, correlationId])
  @@map("change_events")
}

/// Atomic Project-scoped sequence allocator for ChangeEvent.sequence
model ProjectSequence {
  projectId String @id @map("project_id")
  lastValue BigInt @default(0) @map("last_value")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_sequences")
}

/// ADR-0011 — WorldEvent: a domain creative entity on the world line.
/// World time is opaque (world_time_envelope); presentation axis via anchor_story_id + presentation_order.
model WorldEvent {
  id                String        @id @default(uuid())
  projectId         String        @map("project_id")
  anchorStoryId     String?       @map("anchor_story_id")
  title             String
  description       String?
  worldTimeEnvelope Json          @default("{}") @map("world_time_envelope")
  presentationOrder Int?          @map("presentation_order")
  state             ApprovalState @default(draft)
  characterIds      String[]      @default([]) @map("character_ids")
  sceneIds          String[]      @default([]) @map("scene_ids")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")
  deletedAt         DateTime?     @map("deleted_at")
  project           Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, deletedAt])
  @@index([projectId, anchorStoryId, presentationOrder])
  @@map("world_events")
}

/// ADR-0012 — Relationship: independent queryable entity.
/// Polymorphic EntityRef (source_type/source_id, target_type/target_id) — no physical FK.
model Relationship {
  id          String        @id @default(uuid())
  projectId   String        @map("project_id")
  kind        String
  sourceType  String        @map("source_type")
  sourceId    String        @map("source_id")
  targetType  String        @map("target_type")
  targetId    String        @map("target_id")
  direction   String        @default("directed")
  label       String?
  description String?
  validFrom   Json?         @map("valid_from")
  validUntil  Json?         @map("valid_until")
  state       ApprovalState @default(draft)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  deletedAt   DateTime?     @map("deleted_at")
  project     Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, deletedAt])
  @@index([projectId, sourceType, sourceId])
  @@index([projectId, targetType, targetId])
  @@map("relationships")
}

/// H4+ — Presentation Timeline aggregate (world line).
/// Abstract, non-uniform scale: pure presentation coordinates, no real time conversion (ADR-0007).
/// H6: temporal_dimensions is Project-defined; core does not interpret calendar values.
model ProjectTimeline {
  id                  String          @id @default(uuid())
  projectId           String          @unique @map("project_id")
  name                String          @default("World Line")
  description         String?
  temporalDimensions  Json            @default("[]") @map("temporal_dimensions")
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")
  deletedAt           DateTime?       @map("deleted_at")
  project             Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tracks              TimelineTrack[]

  @@index([projectId, deletedAt])
  @@map("project_timelines")
}

model TimelineTrack {
  id         String           @id @default(uuid())
  timelineId String           @map("timeline_id")
  /// character | scene | world_event | organization
  kind       String
  title      String
  order      Int              @default(0)
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")
  deletedAt  DateTime?        @map("deleted_at")
  timeline   ProjectTimeline  @relation(fields: [timelineId], references: [id], onDelete: Cascade)
  items      TimelineItem[]

  @@unique([timelineId, order])
  @@index([timelineId, deletedAt])
  @@map("timeline_tracks")
}

model TimelineItem {
  id                String        @id @default(uuid())
  trackId           String        @map("track_id")
  entityType        String        @map("entity_type")
  entityId          String        @map("entity_id")
  presentationOrder Int           @map("presentation_order")
  startOffsetMs     Int?          @map("start_offset_ms")
  durationMs        Int?          @map("duration_ms")
  /// H6 WorldTimeBinding[] — empty means follow Presentation Time.
  worldTimeBindings Json          @default("[]") @map("world_time_bindings")
  metadata          Json?         @default("{}")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")
  deletedAt         DateTime?     @map("deleted_at")
  track             TimelineTrack @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@unique([trackId, presentationOrder])
  @@index([trackId, entityType, entityId])
  @@map("timeline_items")
}

/// ADR-0013 — Creator Chat. Local single-user mode: no userId on these tables.
/// thread.projectId is null until the "create world" proposal is confirmed.
model CreatorChatThread {
  id                   String             @id @default(uuid())
  projectId            String?            @map("project_id")
  title                String?
  state                String             @default("active")
  /// Last visible message after rollback; null = latest unsuppressed.
  activeHeadMessageId  String?            @map("active_head_message_id")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")
  project              Project?           @relation(fields: [projectId], references: [id], onDelete: SetNull)
  messages             CreatorChatMessage[]

  @@index([projectId])
  @@map("creator_chat_threads")
}

model CreatorChatMessage {
  id              String            @id @default(uuid())
  threadId        String            @map("thread_id")
  role            String
  content         String
  proposal        Json?             @default("{}")
  proposalKey     String?           @map("proposal_key")
  proposalState   String?           @map("proposal_state")
  /// Who spoke this line (character asset, or null = reader / world builder).
  speakerAssetId  String?           @map("speaker_asset_id")
  /// Hidden from the live window after rollback; rows are kept for trace.
  suppressed      Boolean           @default(false)
  createdAt       DateTime          @default(now()) @map("created_at")
  thread          CreatorChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
  @@index([threadId, suppressed])
  @@map("creator_chat_messages")
}

// Track M1 — 分层记忆（docs/planning/Memory-Novel-Roleplay-Design.md §3.2）
// L1 原子记忆：从对话提炼的最小事实单元，PG 为唯一事实源。
model MemoryAtom {
  id              String    @id @default(uuid())
  projectId       String    @map("project_id")
  threadId        String?   @map("thread_id")
  sourceMessageId String?   @map("source_message_id")
  entityType      String?   @map("entity_type")
  entityId        String?   @map("entity_id")
  factType        String    @map("fact_type")
  content         String
  confidence      Float     @default(0.7)
  dedupHash       String    @map("dedup_hash")
  memoryOp        String    @default("ADD") @map("memory_op")
  status          String    @default("active")
  supersededById  String?   @map("superseded_by_id")
  validFrom       DateTime  @default(now()) @map("valid_from")
  validTo         DateTime? @map("valid_to")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([projectId, entityType, entityId])
  @@index([projectId, status, validTo])
  @@index([dedupHash])
  @@map("memory_atoms")
}

// L2 核心记忆：分主题凝练知识块（persona/scenario/world_rule/event_chain）。
model MemoryCore {
  id            String   @id @default(uuid())
  projectId     String   @map("project_id")
  kind          String
  topic         String
  content       String
  version       Int      @default(1)
  sourceAtomIds String[] @default([]) @map("source_atom_ids")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([projectId, kind, topic])
  @@map("memory_cores")
}

// L0 管线状态：每条消息的记忆处理进度（断点续传单位）。
model MemoryPipelineState {
  messageId      String    @id @map("message_id")
  level1At       DateTime? @map("level_1_at")
  extractionMode String    @default("rule") @map("extraction_mode")
  status         String    @default("pending")
  attempts       Int       @default(0)
  lastError      String?   @map("last_error")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@map("memory_pipeline_states")
}

// Track M2 — 冲突清单（D4）：矛盾不自动写入，落库等用户确认；
// 确认 = 写入新原子并取代旧卡，丢弃 = 维持旧卡。不静默改世界实体。
model MemoryConflict {
  id              String    @id @default(uuid())
  projectId       String    @map("project_id")
  threadId        String?   @map("thread_id")
  sourceMessageId String?   @map("source_message_id")
  entityType      String?   @map("entity_type")
  entityId        String?   @map("entity_id")
  factType        String    @map("fact_type")
  incomingContent String    @map("incoming_content")
  existingContent String    @map("existing_content")
  existingAtomId  String?   @map("existing_atom_id")
  antonym         String[]  @default([])
  dedupHash       String    @map("dedup_hash")
  status          String    @default("pending") // pending | resolved | discarded
  decision        String? // keep_new | keep_existing
  resolvedAtomId  String?   @map("resolved_atom_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  resolvedAt      DateTime? @map("resolved_at")

  @@index([projectId, status])
  @@index([threadId, status])
  @@map("memory_conflicts")
}

// 线程级上下文状态：滚动摘要 + 压缩进度（Creator Chat 与未来扮演线程共用）。
model ThreadContextState {
  threadId                 String   @id @map("thread_id")
  rollingSummary           String   @default("") @map("rolling_summary")
  summarizedUntilMessageId String?  @map("summarized_until_message_id")
  summaryVersion           Int      @default(1) @map("summary_version")
  tokenEstimate            Int      @default(0) @map("token_estimate")
  updatedAt                DateTime @updatedAt @map("updated_at")

  @@map("thread_context_states")
}

// M2 小说导入（设计 §5.5）：导入是显式用户动作 = 批量预授权，产物直接写世界层，可整体撤销。
model NovelImport {
  id                String   @id @default(uuid())
  projectId         String   @map("project_id")
  status            String   @default("pending") // pending|processing|done|failed
  sourceFilename    String   @map("source_filename")
  totalChapters     Int      @default(0) @map("total_chapters")
  processedChapters Int      @default(0) @map("processed_chapters")
  mode              String   @default("rule") // rule|llm
  config            Json     @default("{}")
  report            Json?
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  chapters          NovelImportChapter[]

  @@index([projectId, createdAt])
  @@map("novel_imports")
}

model NovelImportChapter {
  id                   String   @id @default(uuid())
  importId             String   @map("import_id")
  chapterIndex         Int      @map("chapter_index")
  title                String?
  status               String   @default("pending") // pending|processing|done|failed
  attempts             Int      @default(0)
  lastError            String?  @map("last_error")
  extractedEntityCount Int      @default(0) @map("extracted_entity_count")
  import               NovelImport @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@unique([importId, chapterIndex])
  @@map("novel_import_chapters")
}

// M3 角色扮演线程（设计 §6.3）：复用 CreatorChatThread 存消息与 SSE；锚点 null = 全书读完。
model RoleplayThread {
  id                   String   @id @default(uuid())
  projectId            String   @map("project_id")
  characterAssetId     String   @map("character_asset_id")
  /// 用户扮演谁；null = 读者（默认）。与 AI 角色卡同一套 Asset。
  userCharacterAssetId String?  @map("user_character_asset_id")
  /// AI speakers in a group thread (2–3 ids). Empty / omitted = 1:1 using characterAssetId.
  participantAssetIds  Json     @default("[]") @map("participant_asset_ids")
  threadId             String   @map("thread_id")
  anchoredWorldEventId String?  @map("anchored_world_event_id")
  status               String   @default("active")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@index([projectId, characterAssetId])
  @@index([threadId])
  @@map("roleplay_threads")
}
