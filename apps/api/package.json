{
  "name": "@zivith/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "history:backfill-baselines": "tsx scripts/backfill-entity-baselines.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.637.0",
    "@aws-sdk/s3-request-presigner": "^3.637.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/jwt": "^9.0.0",
    "@fastify/multipart": "^9.0.1",
    "@zivith/database": "workspace:*",
    "@zivith/domain": "workspace:*",
    "argon2": "^0.40.3",
    "better-sqlite3": "^13.0.3",
    "bullmq": "^5.12.10",
    "dotenv": "^17.4.2",
    "fastify": "^5.4.0",
    "ioredis": "^5.4.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.5.0",
    "tsx": "^4.17.0",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
