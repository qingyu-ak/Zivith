{
  "name": "@zivith/desktop",
  "version": "0.1.0",
  "private": true,
  "author": "Zivith",
  "description": "Zivith local Electron shell (native folder dialog)",
  "main": "src/main.cjs",
  "scripts": {
    "dev": "electron .",
    "start": "electron .",
    "dist": "electron-builder --win dir",
    "shortcut": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/create-shortcut.ps1",
    "typecheck": "node -e \"process.exit(0)\""
  },
  "build": {
    "appId": "com.zivith.studio",
    "productName": "Zivith",
    "copyright": "Zivith",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "dir",
          "arch": ["x64"]
        }
      ]
    }
  },
  "devDependencies": {
    "electron": "^37.4.0",
    "electron-builder": "^26.0.12"
  }
}
