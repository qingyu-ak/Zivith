{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@zivith/cosmos": ["../../packages/cosmos/src/index.ts"],
      "@zivith/cosmos/styles.css": ["../../packages/cosmos/src/styles.css"],
      "@zivith/domain/space": ["../../packages/domain/src/space.ts"]
    }
  },
  "include": ["src"]
}
