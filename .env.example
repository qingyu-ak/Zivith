# Copy this file to .env for local Docker Compose and application development.
NODE_ENV=development
WEB_PORT=3000
API_PORT=4000
API_BASE_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
WEB_ORIGIN=http://localhost:3000

POSTGRES_DB=zivith
POSTGRES_USER=zivith
POSTGRES_PASSWORD=zivith_dev_only
POSTGRES_PORT=5432
DATABASE_URL=postgresql://zivith:zivith_dev_only@localhost:5432/zivith

REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

MINIO_ROOT_USER=zivith
MINIO_ROOT_PASSWORD=zivith_minio_dev_only
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=zivith-media
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=zivith
S3_SECRET_KEY=zivith_minio_dev_only
S3_FORCE_PATH_STYLE=true

# Generate a unique local value. Never reuse it outside local development.
JWT_SECRET=replace_with_a_random_local_secret
LOG_LEVEL=debug

# Phase 2 mock generation. Replace when serving a local placeholder asset.
PLACEHOLDER_VIDEO_URL=https://assets.zivith.local/mock-video.mp4

# --- Phase 2.5 providers (optional; missing keys fall back to Mock) ---
# Text: DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Image / Video / Audio: SiliconFlow（硅基流动）
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
# 文生图 T2I（首张角色/场景）
SILICONFLOW_IMAGE_MODEL=Qwen/Qwen-Image
# 文图生图 I2I（有参考图时的变化/侧脸等）；备选 Kwai-Kolors/Kolors
SILICONFLOW_IMAGE_I2I_MODEL=Qwen/Qwen-Image-Edit
# 文生视频 T2V
SILICONFLOW_VIDEO_MODEL=Wan-AI/Wan2.2-T2V-A14B
# 文图生视频 I2V（有 http(s) 参考帧时）
SILICONFLOW_VIDEO_I2V_MODEL=Wan-AI/Wan2.2-I2V-A14B
SILICONFLOW_AUDIO_MODEL=FunAudioLLM/CosyVoice2-0.5B
# Optional: lower concurrency so video jobs run one-at-a-time (default 1)
# GENERATION_WORKER_CONCURRENCY=1
# After changing domain sheet constants: rebuild packages/domain then restart API.
# Character sheet = one 2×2 T2I image (sheet_turnaround). Location sheet = POST /assets/:id/location-sheet/*.
# I2I may fall back to T2I on SiliconFlow 50507 / 5xx.

# Optional modality overrides: mock | deepseek | siliconflow
# LLM_PROVIDER=deepseek
# IMAGE_PROVIDER=siliconflow
# VIDEO_PROVIDER=siliconflow
# AUDIO_PROVIDER=siliconflow
