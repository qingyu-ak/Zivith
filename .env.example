# Copy this file to .env for local Docker Compose and application development.
NODE_ENV=development
WEB_PORT=3000
API_PORT=4000
API_BASE_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
WEB_ORIGIN=http://localhost:3000

POSTGRES_DB=zivith
POSTGRES_USER=zivith
POSTGRES_PASSWORD=zivith_dev_only
POSTGRES_PORT=5432
DATABASE_URL=postgresql://zivith:zivith_dev_only@localhost:5432/zivith

REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

MINIO_ROOT_USER=zivith
MINIO_ROOT_PASSWORD=zivith_minio_dev_only
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=zivith-media
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=zivith
S3_SECRET_KEY=zivith_minio_dev_only
S3_FORCE_PATH_STYLE=true

# Generate a unique local value. Never reuse it outside local development.
JWT_SECRET=replace_with_a_random_local_secret
LOG_LEVEL=debug

# Phase 2 mock generation. Replace when serving a local placeholder asset.
PLACEHOLDER_VIDEO_URL=https://assets.zivith.local/mock-video.mp4

# --- Phase 2.5 providers (optional; missing keys fall back to Mock) ---
# Text: DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Image / Video / Audio: SiliconFlow（硅基流动）
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell
SILICONFLOW_VIDEO_MODEL=Wan-AI/Wan2.1-T2V-14B
SILICONFLOW_AUDIO_MODEL=FunAudioLLM/CosyVoice2-0.5B

# Optional modality overrides: mock | deepseek | siliconflow
# LLM_PROVIDER=deepseek
# IMAGE_PROVIDER=siliconflow
# VIDEO_PROVIDER=siliconflow
# AUDIO_PROVIDER=siliconflow
